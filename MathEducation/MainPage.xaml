<Page x:Class="MathEducation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MathEducation"
      mc:Ignorable="d" 
      d:DesignHeight="467.04" d:DesignWidth="680"
      Title="MainPage">
    <Page.Resources>

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10"
                        Padding="{TemplateBinding Padding}">

                            <ContentPresenter 
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                Property="Background"
                                Value="LightBlue"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>



    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36*"/>
            <RowDefinition Height="174*"/>
            <RowDefinition Height="257*"/>
        </Grid.RowDefinitions>
        <Button Content="Продолжить" Style="{StaticResource RoundedButtonStyle}" HorizontalAlignment="Center" Height="34" Grid.Row="1" VerticalAlignment="Top" Width="262" Margin="0,120,0,0"/>
        <Label Content="Вы остановились на" HorizontalAlignment="Center" Margin="0,10,0,0" Grid.Row="1" VerticalAlignment="Top"/>
        <Label Content="{Binding SectionId, StringFormat='Раздел №{0}'}" HorizontalAlignment="Left" Margin="166,41,0,0" Grid.Row="1" VerticalAlignment="Top" Width="131"/>
        <Label Content="{Binding TopicId, StringFormat='Тема №{0}'}" HorizontalAlignment="Left" Margin="362,36,0,0" Grid.Row="1" VerticalAlignment="Top" Width="82"/>


    </Grid>
</Page>
