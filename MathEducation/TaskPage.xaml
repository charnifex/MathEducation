<Page x:Class="MathEducation.TaskPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:MathEducation"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TaskPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42*"/>
            <RowDefinition Height="76*"/>
            <RowDefinition Height="201*"/>
            <RowDefinition Height="148*"/>
        </Grid.RowDefinitions>
        <Label HorizontalAlignment="Left" VerticalAlignment="Center" Width="330" Content="{Binding TaskId, StringFormat='Задание №{0}'}" Height="10"/>
        <Label Content="{Binding QuestionText}" HorizontalAlignment="Center" Grid.Row="1" VerticalAlignment="Center" Height="76" Width="680"/>
        <StackPanel Grid.Row="2">
            <Image Height="199" Width="369" Source="{Binding Image}"/>
        </StackPanel>
        <Label Content="Ответ:" HorizontalAlignment="Left" Height="30" Margin="243,50,0,0" Grid.Row="3" VerticalAlignment="Top" Width="49"/>
        <TextBox HorizontalAlignment="Left" Margin="297,56,0,0" Grid.Row="3" TextWrapping="Wrap"  VerticalAlignment="Top" Width="211"/>

    </Grid>
</Page>
